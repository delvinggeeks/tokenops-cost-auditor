# TokenOps Cost Auditor — environment template (docs/03-LLD.md §7).
# cp .env.example .env && chmod 600 .env, then fill secrets (runbook §5).
# Every variable in src/tokenops_cost_auditor/config.py appears here (test-enforced).

# ---- Core ----
APP_ENV=dev                       # dev | staging | prod
SECRET_KEY=                       # 64 bytes random, e.g. `openssl rand -hex 64`
DATABASE_URL=postgresql+psycopg://tokenops_cost_auditor:tokenops_cost_auditor@localhost:5432/tokenops_cost_auditor
UPLOAD_DIR=uploads                # compose overrides to /data/uploads
REPORT_DIR=reports                # compose overrides to /data/reports
BACKUP_DIR=backups                # compose mounts the backups volume here (ro in app)
MAX_UPLOAD_MB=200                 # FR-01
MAX_CONCURRENT_AUDITS=2           # NFR-13 (R-API): audits beyond cap hold queued
PURGE_AFTER_DAYS=7                # FR-21
ADMIN_TOKEN=                      # long random token; empty disables admin (FR-19)

# ---- Compose-only ----
POSTGRES_PASSWORD=                # postgres superuser password (compose network only)
DOMAIN=localhost                  # public domain for Caddy auto-TLS, e.g. audit.example.com

# ---- Payments (env-gated, FR-18) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PAYMENT_LINK_URL=
STRIPE_WEBHOOK_SECRET=
STRIPE_PAYMENT_LINK_URL=

# ---- Mail (env-gated, FR-20; unset SMTP_HOST = log-only adapter) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
APP_BASE_URL=                     # absolute-link prefix for emails (FR-20)
DIGEST_TO=                        # founder address for daily ops digest; empty = stdout only

# ---- Observability (NFR-06, env-gated) ----
SENTRY_DSN=

# ---- Detector thresholds (docs/03-LLD.md §3; defaults recorded in golden notes sheet) ----
D1_SHORT_COMPLETION_T=150
D1_FRONTIER_MODELS=[]             # extra frontier models w/o map entry (R-D1-MAP f)
D1_MODEL_MAP={}                   # override of the R-D1-MAP seed in config.py
D2_CACHE_MIN_REPEATS=25
D2_CACHE_MIN_PROMPT_TOKENS=1024
D2_SUFFIX_HAIRCUT=0.8             # founder ruling R-Q5
D2_TTL_WINDOW_S=300               # founder ruling R-Q4 (est_writes windows, fallback)
D2_TTL_WINDOWS={"anthropic": 300, "gpt-5.6": 1800}  # correction C4: per provider-family
D2_NO_WINDOW_HAIRCUT=0.7          # founder ruling R-Q4
D3_BLOAT_MULT=2.0
D4_WINDOW_S=120
D4_DUP_MIN=3
D5_RESERVED_BILLING=false
D5_MAX_RATIO=4.0                  # LLD: declared_max >= 4x completion p95
D6_LOOP_MIN=8
D6_BATCH_SZ=5
D6_SMALL_COMPLETION_T=300         # LLD: loop calls < 300 completion tokens
D6_RUN_WINDOW_S=600               # LLD: run within 10 min
D6_SESSION_GAP_S=900              # LLD: session = tag + 15-min gap split
D6_REREAD_MIN=5                   # LLD: same prefix_hash >= 5 = agent re-read
D8_CONCENTRATION_MIN_SHARE=0.5    # flag a route at >= this share of total spend (informational)
D9_MIN_CACHE_WRITE_TOKENS=1024    # min cache-write tokens before flagging ineffective caching
D10_MIN_DAYS=7                    # min distinct days before daily-spike anomaly detection runs
D10_Z_THRESHOLD=3.5              # a day is a spike at >= this many MADs above the median day
D10_SPIKE_MULT=2.0               # AND at least this multiple of the typical (median) day
PREFIX_HASH_CHARS=4096            # founder ruling R-Q6 (~1024 tokens)
RULES_DISABLED=[]                 # JSON list of detector names to skip
MIN_FINDING_MONTHLY_USD=0.005      # drop savings findings below this (they render as $0.00); informational $0 kept

# ---- Report & sessions ----
REPORT_URL_EXPIRY_DAYS=30         # accepted default Q9
SESSION_TTL_DAYS=7                # accepted default Q11

# ---- Display (NFR-11) ----
INR_PER_USD_DISPLAY=90.0

# ---- v1.5 MONITOR (PLAN-V15 §0; prices fixed by R-Q11, INR list in config) ----
PLAN_PRO_USD=99.0
PLAN_TEAM_USD=299.0
PLAN_PRO_INR=8999.0
PLAN_TEAM_INR=26999.0
PLAN_SOURCE_LIMITS={"free": 0, "pro": 1, "team": 5}
CONNECT_BACKFILL_DAYS=365
FORECAST_OVERSPEND_PCT=30.0
ALERT_SPEND_SPIKE_DOD_PCT=30.0
ALERT_WASTE_TARGET_PCT=25.0
DUNNING_READONLY_DAYS=7
DUNNING_CANCEL_DAYS=21

# Signup federation (Google OAuth) — button renders only when set
DOCS_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# R-PRICING-FINAL-2 (2026-07-22): list + launch prices, per-market cohorts.
# Defaults in config.py are the ruled values; override only by ruling.
PLAN_PRO_USD_LAUNCH=
PLAN_TEAM_USD_LAUNCH=
PLAN_PRO_INR_LAUNCH=
PLAN_TEAM_INR_LAUNCH=
LAUNCH_COHORT_SIZE=
ONE_SHOT_USD=
ONE_SHOT_INR=
PLAN_PRO_SPEND_GATE_USD=
PLAN_TEAM_SPEND_GATE_USD=
QUALIFY_SPEND_USD=
PLAN_PRO_USD_INDIA=
PLAN_PRO_USD_INDIA_LAUNCH=
PLAN_TEAM_USD_INDIA=
ONE_SHOT_USD_INDIA=
SUPPORT_EMAIL=
STATUS_URL=
# compose-level (Caddy): DOMAIN=<live domain>

STRIPE_PAYMENT_LINK_PRO=
STRIPE_PAYMENT_LINK_TEAM=
RAZORPAY_PAYMENT_LINK_PRO=
RAZORPAY_PAYMENT_LINK_TEAM=

# Flywheel rung thresholds (M-FLY-0; Honesty Law — docs/12 Stage 3)
FLYWHEEL_L1_MIN_CUSTOMERS=10
FLYWHEEL_L2_MIN_CUSTOMERS=25
FLYWHEEL_L3_MIN_CUSTOMERS=50
FLYWHEEL_L3_MIN_HISTORY_MONTHS=6

# WP-DEVOPS-OBS: stamped automatically by provision.sh at every deploy —
# maps error-tracking events to the exact deployed tag. Leave empty locally.
RELEASE_TAG=
