# TokenOps Cost Auditor — environment template (docs/03-LLD.md §7).
# cp .env.example .env && chmod 600 .env, then fill secrets (runbook §5).
# Every variable in src/tokenops_cost_auditor/config.py appears here (test-enforced).

# ---- Core ----
APP_ENV=dev                       # dev | staging | prod
SECRET_KEY=                       # 64 bytes random, e.g. `openssl rand -hex 64`
DATABASE_URL=postgresql+psycopg://tokenops_cost_auditor:tokenops_cost_auditor@localhost:5432/tokenops_cost_auditor
UPLOAD_DIR=uploads                # compose overrides to /data/uploads
REPORT_DIR=reports                # compose overrides to /data/reports
MAX_UPLOAD_MB=200                 # FR-01
PURGE_AFTER_DAYS=7                # FR-21
ADMIN_TOKEN=                      # long random token; empty disables admin (FR-19)

# ---- Compose-only ----
POSTGRES_PASSWORD=                # postgres superuser password (compose network only)
DOMAIN=localhost                  # public domain for Caddy auto-TLS, e.g. audit.example.com

# ---- Payments (env-gated, FR-18) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PAYMENT_LINK_URL=
STRIPE_WEBHOOK_SECRET=
STRIPE_PAYMENT_LINK_URL=

# ---- Mail (env-gated, FR-20; unset SMTP_HOST = log-only adapter) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Observability (NFR-06, env-gated) ----
SENTRY_DSN=

# ---- Detector thresholds (docs/03-LLD.md §3; defaults recorded in golden notes sheet) ----
D1_SHORT_COMPLETION_T=150
D1_FRONTIER_MODELS=[]             # extra frontier models w/o map entry (R-D1-MAP f)
D1_MODEL_MAP={}                   # override of the R-D1-MAP seed in config.py
D2_CACHE_MIN_REPEATS=25
D2_CACHE_MIN_PROMPT_TOKENS=1024
D2_SUFFIX_HAIRCUT=0.8             # founder ruling R-Q5
D2_TTL_WINDOW_S=300               # founder ruling R-Q4 (est_writes windows, fallback)
D2_TTL_WINDOWS={"anthropic": 300, "gpt-5.6": 1800}  # correction C4: per provider-family
D2_NO_WINDOW_HAIRCUT=0.7          # founder ruling R-Q4
D3_BLOAT_MULT=2.0
D4_WINDOW_S=120
D4_DUP_MIN=3
D5_RESERVED_BILLING=false
D5_MAX_RATIO=4.0                  # LLD: declared_max >= 4x completion p95
D6_LOOP_MIN=8
D6_BATCH_SZ=5
D6_SMALL_COMPLETION_T=300         # LLD: loop calls < 300 completion tokens
D6_RUN_WINDOW_S=600               # LLD: run within 10 min
D6_SESSION_GAP_S=900              # LLD: session = tag + 15-min gap split
D6_REREAD_MIN=5                   # LLD: same prefix_hash >= 5 = agent re-read
PREFIX_HASH_CHARS=4096            # founder ruling R-Q6 (~1024 tokens)
RULES_DISABLED=[]                 # JSON list of detector names to skip

# ---- Report & sessions ----
REPORT_URL_EXPIRY_DAYS=30         # accepted default Q9
SESSION_TTL_DAYS=7                # accepted default Q11

# ---- Display (NFR-11) ----
INR_PER_USD_DISPLAY=90.0
