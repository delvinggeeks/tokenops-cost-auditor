%% audit-seq.mmd — Audit happy-path sequence diagram
%% Generated at G4 sweep (covers D6+D7) from docs/02-HLD.md §3 (key data
%% flow) as IMPLEMENTED in api/routes_upload.py + services/runner.py per
%% .gates/d6-d7.diff. Architect gate duty per founder ruling R-Q1.
%% D7-vs-D6 boundary: no new step introduced. D6 fixed the pipeline
%% (queued -> processing -> done|failed, NFR-13 slot admission, JSON report).
%% D7 added PDF rendering + the signed /r/ mail link INSIDE the existing
%% "report" step of the D6 runner — not a new stage, per STATUS.md D6-D7
%% paragraph ("Runner renders JSON+HTML+PDF, mails signed /r/ link").

sequenceDiagram
    autonumber
    actor U as Browser/CLI user
    participant API as api/routes_upload.py<br/>(/api/v1)
    participant DB as persistence<br/>(repo.py + models.py)
    participant LOG as lifecycle/auditlog.py
    participant BG as FastAPI BackgroundTasks<br/>(ADR-5, no queue)
    participant R as services/runner.py<br/>AuditRunner
    participant ING as services/ingest
    participant PR as services/pricing
    participant RU as services/rules (D1..D6)
    participant RM as services/report/model.py<br/>ReportModel.build()
    participant JSON as report/render_json.py
    participant PDF as report/render_pdf.py<br/>(weasyprint, ADR-4)
    participant SGN as report/signer.py
    participant MAIL as services/mail
    participant WEB as web/routes_report.py

    U->>API: POST /api/v1/audits (file, Idempotency-Key,<br/>X-User-Email pre-D8 stub)
    API->>DB: get_or_create_user() / find_idempotent_audit()
    alt Idempotency-Key replay (FR-26)
        API-->>U: 200 {audit_id, replayed:true}
    else new audit
        API->>API: stream upload to disk, 200MB cap (FR-01)
        API->>DB: Audit(status=queued)
        API->>LOG: audit.uploaded
        API-->>U: 201 {audit_id, replayed:false}
        API->>BG: add_task(runner.run, audit_id)
        BG->>R: run(audit_id)
        R->>DB: processing_count() -- NFR-13 admission slot wait
        R->>DB: Audit.status = processing
        R->>ING: detect_format + parse + normalize -> CallRecordFrame
        R->>ING: validator.enforce() (FR-03 row errors, user-safe failures)
        R->>PR: coster.add cost columns + reconcile() (NFR-07)
        R->>RU: registry.run_all(frame) -> findings[]
        R->>RM: ReportModel.build(priced, findings, unpriced, table)<br/>-- single money-math assembly point
        R->>JSON: render_json(report) -> reports/{audit_id}.json
        R->>PDF: render_pdf(report) -> reports/{audit_id}.pdf<br/>(shared HTML body with web view)
        R->>SGN: sign_report_url(audit_id) -> 30-day /r/ token
        R->>DB: persist findings + call_aggregates (FR-22 aggregates only)
        R->>DB: Audit.status = done, report_ready_at
        R->>LOG: audit.completed
        R->>MAIL: send report-ready mail with signed /r/ link
        Note over R,LOG: on failure at any stage: Audit.status = failed,<br/>audit_log event, user-safe error message
    end

    U->>API: GET /api/v1/audits/{id}/status (poll)
    API->>DB: session.get(Audit), queue_position() if queued
    API-->>U: {status, queue_position?, valid_pct?, error?}

    U->>WEB: GET /r/{token}
    WEB->>SGN: verify_report_url(token)
    WEB-->>U: HTML report (shared _report_body partial)
    U->>WEB: GET /r/{token}/pdf
    WEB->>SGN: verify_report_url(token)
    WEB-->>U: FileResponse (reports/{audit_id}.pdf)
