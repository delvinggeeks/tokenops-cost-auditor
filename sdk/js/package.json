{
  "name": "tokenops-cost-auditor",
  "version": "0.1.0",
  "description": "Official TypeScript/JavaScript SDK for TokenOps Cost Auditor — send usage (counts only) and read your audits and findings.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && node --test --experimental-strip-types src/index.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "tokenops",
    "llm",
    "cost",
    "observability",
    "openai",
    "anthropic"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3"
  }
}
