# Auto-TLS reverse proxy (NFR-02). DOMAIN comes from .env via compose;
# defaults to localhost (internal self-signed cert) for staging/dev.
{$DOMAIN:localhost} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy app:8000
}

# www → apex. The www A record exists; without this block Caddy has no cert
# for the name and browsers see a TLS error instead of the product.
www.{$DOMAIN:localhost} {
	redir https://{$DOMAIN:localhost}{uri} permanent
}

# R-DOMAIN-MIGRATE (2026-07-22): after cutover the RETIRED domain 301s every
# path to its new home, docs subdomain included — old links, old emails and
# old search results keep working. OLD_DOMAIN is unset until cutover; the
# .invalid default makes these blocks inert (no cert is ever requested for
# it because .invalid is unresolvable by definition).
{$OLD_DOMAIN:old.invalid} {
	redir https://{$DOMAIN:localhost}{uri} permanent
}

www.{$OLD_DOMAIN:old.invalid} {
	redir https://{$DOMAIN:localhost}{uri} permanent
}

docs.{$OLD_DOMAIN:old.invalid} {
	redir https://docs.{$DOMAIN:localhost}{uri} permanent
}

# Public docs-site (mkdocs build output; shipped to ./site by provision.sh
# step 4c and bind-mounted read-only — empty dir just 404s until shipped).
docs.{$DOMAIN:localhost} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	root * /srv/docs
	file_server
}
